# Docker container created from supersunho/palworld-server.
PALWORLD_CONTAINER=palworld-server

# Defaults below match that image. Override only if your container layout differs.
PALWORLD_APP_ID=2394010
PALWORLD_SERVER_DIR=/home/steam/palworld_server
PALWORLD_BACKUP_DIR=/home/steam/backups
PALWORLD_STEAMCMD=/home/steam/steamcmd/steamcmd.sh
PALWORLD_GOSU=gosu

PALWORLD_HEALTH_TIMEOUT=240
PALWORLD_STOP_TIMEOUT=90

PALWORLD_UPDATE_REQUEST_PATH=/run/palworld/update.request
PALWORLD_UPDATE_STATUS_PATH=/run/palworld/update.status.json
PALWORLD_UPDATE_LOCK_PATH=/run/palworld/update.lock
